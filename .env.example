# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Database
# Leave blank to use local SQLite (recommended for development/grading).
# Or set to a PostgreSQL URL, e.g.:
# DATABASE_URL=postgres://smartmed_user:smartmed_pass@localhost:5432/smartmed
DATABASE_URL=

# Demo mode — when True, all seeded inventory/pharmacy data is clearly
# labeled as demo/simulated data throughout the UI and API responses.
DEMO_MODE=True

# External service configuration (all optional; system runs fully offline
# without any of these being set — see README "Offline / Demo Mode")
OCR_PATH=
MAP_PROVIDER=osm
GEOCODING_PROVIDER=nominatim

# Prescription upload handling
PRESCRIPTION_MAX_UPLOAD_MB=5
PRESCRIPTION_RETENTION_DAYS=30
